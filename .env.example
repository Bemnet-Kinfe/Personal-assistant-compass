# Copy to .env for local development, then load it: set -a; source .env; set +a
# Never commit the real .env.
DEBUG=1
ENVIRONMENT=development
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset to use SQLite locally, or point at Postgres:
# DATABASE_URL=postgresql://compass:compass@localhost:5432/compass
TIME_ZONE=America/New_York

# Who can have an account. Sign-up is closed unless SIGNUP_OPEN=1.
SIGNUP_OPEN=0
ALLOWED_EMAILS=


